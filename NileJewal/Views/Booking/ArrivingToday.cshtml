@model IEnumerable<NileJewal.Models.Booking>

@{
    ViewData["Title"] = "النزلاء على وصول اليوم";
}

<div class="container py-4" dir="rtl">
    <div class="card shadow-sm border-0 mb-4 bg-white rounded-3 p-4">
        <h3 class="text-primary fw-bold mb-0">
            <i class="fas fa-sign-in-alt me-2"></i> الغرف والنزلاء على وصول اليوم (@DateTime.Today.ToString("yyyy/MM/dd"))
        </h3>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var booking in Model)
            {
                <div class="col-md-4 mb-4">
                    <!-- تغيير لون إطار الكارت حسب حالة التسكين -->
                    <div class="card shadow-sm border-0 rounded-3 text-start h-100" style="border-top: 5px solid @(booking.IsCheckedIn ? "#198754" : "#0d6efd") !important;">
                        <div class="card-body" style="text-align: justify;" dir="rtl">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">غرفة رقم: @booking.Room?.RoomNumber</h5>
                                @if (booking.IsCheckedIn)
                                {
                                    <span class="badge bg-success px-3 py-2">تم التسكين</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary px-3 py-2">على وصول</span>
                                }
                            </div>
                            
                            <p class="mb-2"><strong>اسم النزيل:</strong> @booking.GuestName</p>
                            <p class="mb-2"><strong>رقم الموبايل:</strong> @booking.GuestPhone</p>
                            <p class="mb-2"><strong>نوع الغرفة:</strong> @booking.RoomType</p>
                            <p class="mb-2"><strong>تاريخ المغادرة:</strong> @booking.CheckOutDate.ToString("yyyy/MM/dd")</p>
                            <p class="mb-3"><strong>المبلغ المتبقي:</strong> <span class="text-danger fw-bold">@booking.RemainingAmount.ToString("N2") ج.م</span></p>

                            <div class="d-flex gap-2">
                                <a style="display: none;" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-outline-primary btn-sm w-50 fw-bold">
                                    <i class="fas fa-info-circle me-1"></i> التفاصيل
                                </a>
                                
                                <form style="width: 100%;" asp-action="ToggleCheckInStatus" asp-route-id="@booking.Id" method="post" >
                                    @if (booking.IsCheckedIn)
                                    {
                                        <button style="width: 100%;" type="submit" class="btn btn-outline-secondary btn-sm w-100 fw-bold">
                                            <i class="fas fa-undo me-1"></i> إلغاء التسكين
                                        </button>
                                    }
                                    else
                                    {
                                        <button  style="width: 100%;" type="submit" class="btn btn-success btn-sm w-100 fw-bold">
                                            <i class="fas fa-check-circle me-1"></i> تم التسكين
                                        </button>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center shadow-sm py-4" role="alert">
                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                    <p class="mb-0 fw-bold">لا توجد حجوزات مقررة للوصول اليوم.</p>
                </div>
            </div>
        }
    </div>
</div>