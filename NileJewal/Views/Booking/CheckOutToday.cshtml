@model IEnumerable<NileJewal.Models.Booking>

@{
    ViewData["Title"] = "غرف مغادرة اليوم";
}

<div class="container py-4" dir="rtl">
    <div class="card shadow-sm border-0 mb-4 bg-white rounded-3 p-4">
        <h3 class="text-primary fw-bold mb-0">
            <i class="fas fa-sign-out-alt me-2"></i> الغرف المقرر مغادرتها اليوم (@DateTime.Today.ToString("yyyy/MM/dd"))
        </h3>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var booking in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 rounded-3 text-start h-100" style="border-top: 5px solid @(booking.IsCheckedOut ? "#198754" : "#dc3545") !important;">
                        <div class="card-body" style="text-align: justify;" dir="rtl">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">غرفة رقم: @booking.Room?.RoomNumber</h5>
                                @if (booking.IsCheckedOut)
                                {
                                    <span class="badge bg-success px-3 py-2">تم المغادرة</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">في انتظار المغادرة</span>
                                }
                            </div>
                            
                            <p class="mb-2"><strong>اسم النزيل:</strong> @booking.GuestName</p>
                            <p class="mb-2"><strong>رقم الموبايل:</strong> @booking.GuestPhone</p>
                            <p class="mb-2"><strong>نوع الغرفة:</strong> @booking.RoomType</p>
                            <p class="mb-3"><strong>المبلغ المتبقي:</strong> <span class="text-danger fw-bold">@booking.RemainingAmount.ToString("N2") ج.م</span></p>

                            @if (booking.IsCheckedOut)
                            {
                                <form asp-action="ToggleCheckOutStatus" asp-route-id="@booking.Id" method="post" class="mt-3">
                                    <button type="submit" class="btn btn-outline-secondary w-100 fw-bold">
                                        <i class="fas fa-undo me-1"></i> إلغاء تفعيل المغادرة
                                    </button>
                                </form>
                            }
                            else
                            {
                                @if (booking.RemainingAmount > 0)
                                {
                                    <!-- تنبيه وزر غير مفعل أو يحذر بوجود مبالغ متبقية -->
                                    <div class="alert alert-warning py-2 px-2 text-center mb-2" style="font-size: 13px;">
                                        <i class="fas fa-exclamation-triangle me-1"></i> لا يمكن المغادرة، يوجد مبلغ متبقي: <strong>@booking.RemainingAmount.ToString("N2") ج.م</strong>
                                    </div>
                                    <button type="button" class="btn btn-secondary w-100 fw-bold" disabled>
                                        <i class="fas /lock me-1"></i> ممتنع (يوجد متبقي)
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="ToggleCheckOutStatus" asp-route-id="@booking.Id" method="post" class="mt-3">
                                        <button type="submit" class="btn btn-success w-100 fw-bold">
                                            <i class="fas fa-check-circle me-1"></i> تم خروج النزيل (تعليم كـ مغادر)
                                        </button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center shadow-sm py-4" role="alert">
                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                    <p class="mb-0 fw-bold">لا توجد غرف مقررة للمغادرة اليوم.</p>
                </div>
            </div>
        }
    </div>
</div>