<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" dir="rtl">
            <form asp-controller="Booking" asp-action="Transfer" method="post">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">نقل حجز النزيل: <span id="transferGuestName"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="BookingId" id="transferBookingId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">الغرفة الحالية:</label>
                        <span id="transferCurrentRoom" class="badge bg-secondary fs-6"></span>
                    </div>

                    <div class="mb-3">
    <label class="form-label">اختر الغرفة الجديدة</label>
    <select name="newRoomNumber" class="form-select" required>
        <option value="">-- اختر الغرفة --</option>
        @foreach (var room in Model)
        {
            <option value="@room.RoomNumber">غرفة رقم @room.RoomNumber</option>
        }
    </select>
</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-info text-white fw-bold">تأكيد النقل</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // التبديل بين وجهي الكارت (MU والإسكان)
        function toggleRoomView(roomId, targetSide) {
            const primarySide = document.getElementById(`booking-side-primary-${roomId}`);
            const secondarySide = document.getElementById(`booking-side-secondary-${roomId}`);

            if (targetSide === 'secondary') {
                if (primarySide) primarySide.classList.add('d-none');
                if (secondarySide) secondarySide.classList.remove('d-none');
            } else {
                if (secondarySide) secondarySide.classList.add('d-none');
                if (primarySide) primarySide.classList.remove('d-none');
            }
        }

        // إظهار/إخفاء حقل عدد الأفراد بناءً على نوع الغرفة
        function toggleOccupancy(typeSelectId, containerId) {
            const select = document.getElementById(typeSelectId);
            const container = document.getElementById(containerId);
            if (select && container) {
                if (select.value === 'MU') {
                    container.classList.add('d-none');
                } else {
                    container.classList.remove('d-none');
                }
            }
        }

        // إظهار/إخفاء تفاصيل الأغذية
        function toggleFoodFields(checkboxId, detailsId) {
            const checkbox = document.getElementById(checkboxId);
            const details = document.getElementById(detailsId);
            if (checkbox && details) {
                if (checkbox.checked) {
                    details.classList.remove('d-none');
                } else {
                    details.classList.add('d-none');
                }
            }
        }

        // فتح مودال إضافة حجز جديد
        function openCreateModal(roomId, roomNumber) {
            document.getElementById('modalRoomId').value = roomId;
            document.getElementById('modalRoomNumber').innerText = roomNumber;
            
            const modal = new bootstrap.Modal(document.getElementById('createModal'));
            modal.show();
        }

        // فتح مودال تعديل الحجز وتعبئة البيانات (تم تصحيح جلب وتعيين الوجبات هنا)
        function openEditModalFromButton(btn) {
            const ds = btn.dataset;
            document.getElementById('editId').value = ds.id;
            document.getElementById('editRoomId').value = ds.roomId;
            document.getElementById('editGuestName').value = ds.guestName;
            document.getElementById('editGuestPhone').value = ds.guestPhone;
            document.getElementById('editRoomType').value = ds.roomType;
            document.getElementById('editOccupancyType').value = ds.occupancyType;
            
            const hasFood = ds.hasFood === 'true';
            const editHasFoodCb = document.getElementById('editHasFood');
            editHasFoodCb.checked = hasFood;
            
            // تعيين نوع الوجبة في القائمة المنسدلة بدقة
            const mealTypeSelect = document.getElementById('editMealType');
            if (ds.mealType && ds.mealType.trim() !== "") {
                mealTypeSelect.value = ds.mealType;
            } else {
                mealTypeSelect.value = "بدون وجبات";
            }

            document.getElementById('editDailyFood').value = ds.dailyFood || 0;
            document.getElementById('editPrice').value = ds.price;
            document.getElementById('editPaid').value = ds.paid;
            document.getElementById('editReceipt').value = ds.receipt || '';
            document.getElementById('editCheckIn').value = ds.checkIn;
            document.getElementById('editCheckOut').value = ds.checkOut;
            document.getElementById('editNotes').value = ds.notes || '';

            toggleOccupancy('editRoomType', 'editOccupancyContainer');
            toggleFoodFields('editHasFood', 'editFoodDetails'); // تفعيل إظهار/إخفاء صندوق الأغذية بالاعتماد على الحالة

            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        // فتح مودال النقل
        function openTransferModalFromButton(btn) {
            const ds = btn.dataset;
            document.getElementById('transferBookingId').value = ds.bookingId;
            document.getElementById('transferGuestName').innerText = ds.guestName;
            document.getElementById('transferCurrentRoom').innerText = ds.roomNumber;

            const modal = new bootstrap.Modal(document.getElementById('transferModal'));
            modal.show();
        }
        function validatePhone(input) {
    // منع أي حروف غير الأرقام
    input.value = input.value.replace(/[^0-9]/g, '');
    
    var errorDiv = document.getElementById('phoneError');
    var pattern = /^01[0125][0-9]{8}$/;
    
    if (input.value.length > 0 && input.value.length < 11) {
        errorDiv.style.display = 'block';
        errorDiv.innerText = 'رقم الموبايل يجب أن يكون 11 رقماً';
    } else if (input.value.length === 11 && !pattern.test(input.value)) {
        errorDiv.style.display = 'block';
        errorDiv.innerText = 'الرقم غير صحيح';
    } else {
        errorDiv.style.display = 'none';
        errorDiv.innerText = '';
    }
}
    </script>
}