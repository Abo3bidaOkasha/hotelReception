@using System.Globalization
@using System.Text.Encodings.Web
@model IEnumerable<NileJewal.Models.Room>
@{
    ViewData["Title"] = "مخطط الغرف اليومي";
    DateTime selectedDate = ViewBag.SelectedDate;
}

<div class="container-fluid mt-3" dir="rtl">

    <!-- شريط التنبيهات والرسائل -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show my-2 rounded-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill ms-2"></i>
            <strong>تنبيه: </strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show my-2 rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill ms-2"></i>
            <strong>تم بنجاح! </strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- هيدر اختيار التاريخ والتنقل -->
    <div class="card shadow-sm border-0 mb-4 bg-white rounded-3">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3 py-3">
            <h4 class="m-0 fw-bold text-primary d-flex align-items-center gap-2">
                <i class="bi bi-calendar-event-fill text-warning"></i>
                حجز غرف عن يوم: <span class="text-dark">@selectedDate.ToString("yyyy/MM/dd")</span>
            </h4>
            <!--zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-->
            <!--zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-->
            <form method="get" asp-controller="Booking" asp-action="DailyGrid" class="d-flex align-items-center gap-2">
                <a asp-controller="Booking" asp-action="DailyGrid" asp-route-date="@selectedDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-chevron-right"></i> السابق
                </a>
                <input type="date" name="date" class="form-control form-control-sm rounded-pill px-3 border-secondary" value="@selectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" style="max-width: 160px;" />
                <a asp-controller="Booking" asp-action="DailyGrid" asp-route-date="@selectedDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold">
                    التالي <i class="bi bi-chevron-left"></i>
                </a>
            </form>
        </div>
    </div>

    <!-- شبكة الغرف -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        @foreach (var room in Model)
        {
            var bookingsList = room.Bookings?.ToList() ?? new List<NileJewal.Models.Booking>();
            bool isOccupied = bookingsList.Any();

            var muBooking = bookingsList.FirstOrDefault(b => b.RoomType == "MU");
            var housingBooking = bookingsList.FirstOrDefault(b => b.RoomType != "MU");

            var primaryBooking = muBooking ?? bookingsList.FirstOrDefault();
            bool hasDoubleBooking = muBooking != null && housingBooking != null;
            bool canAddHousingBooking = muBooking != null && housingBooking == null;

            string headerBgClass = !isOccupied ? "bg-success text-white" : (hasDoubleBooking ? "bg-warning text-dark" : "bg-danger text-white");
            string badgeBgClass = !isOccupied ? "bg-white text-success" : (hasDoubleBooking ? "bg-dark text-warning" : "bg-white text-danger");
            string statusText = !isOccupied ? "متاحة" : (hasDoubleBooking ? "MU + إسكان" : "محجوزة");

            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3 custom-room-card">

                    <!-- رأس الكارت -->
                    <div class="card-header border-0 d-flex justify-content-between align-items-center py-2 px-3 @headerBgClass">
                        <span class="fw-bold fs-5">
                            <i class="bi bi-door-closed-fill ms-1"></i> غرفة رقم: @room.RoomNumber
                        </span>
                        <span class="badge @badgeBgClass fw-bold rounded-pill px-3">
                            @statusText
                        </span>
                    </div>

                    <!-- جسم الكارت -->
                    <div class="card-body p-3 d-flex flex-column justify-content-between bg-white">
                        @if (isOccupied && primaryBooking != null)
                        {
                            <!-- الوجه الأول: حجز الـ MU أو الحجز الرئيسي -->
                            <div id="booking-side-primary-@room.Id" class="booking-side">
                                @if (hasDoubleBooking)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                        <span class="badge bg-danger">حجز 1 (MU)</span>
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0 fs-7 fw-bold" onclick="toggleRoomView(@room.Id, 'secondary')">
                                            الإسكان <i class="bi bi-chevron-left"></i>
                                        </button>
                                    </div>
                                }

                                @{
                                    var pNights = (int)(primaryBooking.CheckOutDate - primaryBooking.CheckInDate).TotalDays;
                                    if (pNights <= 0) pNights = 1;
                                }

                                <ul class="list-group list-group-flush p-0 mb-3 small fs-6">
                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-person-fill text-primary fs-5"></i>
                                        <strong class="text-dark">الاسم:</strong>
                                        <span class="text-secondary fw-semibold text-truncate">@primaryBooking.GuestName</span>
                                    </li>
                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-telephone-fill text-success fs-6"></i>
                                        <strong class="text-dark">موبايل:</strong>
                                        <span class="text-secondary dir-ltr">@primaryBooking.GuestPhone</span>
                                    </li>
                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-house-door-fill text-primary fs-6"></i>
                                        <strong class="text-dark">نوع الغرفة:</strong>
                                        <span class="badge bg-secondary">@(string.IsNullOrEmpty(primaryBooking.RoomType) ? "إسكان" : primaryBooking.RoomType)</span>
                                    </li>

                                    @if (primaryBooking.RoomType != "MU")
                                    {
                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-people-fill text-info fs-6"></i>
                                            <strong class="text-dark">عدد الأفراد:</strong>
                                            <span class="badge bg-info text-dark">@(string.IsNullOrEmpty(primaryBooking.OccupancyType) ? "سنجل" : primaryBooking.OccupancyType)</span>
                                        </li>
                                    }

                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-egg-fried text-warning fs-6"></i>
                                        @* <strong class="text-dark">الأغذية:</strong>
                                        <span class="text-secondary">@(string.IsNullOrEmpty(primaryBooking.MealType) ? "بدون وجبات" : primaryBooking.MealType)</span> *@
                                    <strong class="text-dark">الأغذية:</strong>
    <span class="text-secondary">@(primaryBooking.HasFood ? $"{primaryBooking.DailyFoodAmount} ج.م" : "افطار فقط")</span>
                                        </li>

                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-calendar-check-fill text-info fs-6"></i>
                                        <strong class="text-dark">الوصول:</strong>
                                        <span class="text-secondary">@primaryBooking.CheckInDate.ToString("yyyy/MM/dd")</span>
                                    </li>
                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-calendar-x-fill text-warning fs-6"></i>
                                        <strong class="text-dark">المغادرة:</strong>
                                        <span class="text-secondary">@primaryBooking.CheckOutDate.ToString("yyyy/MM/dd")</span>
                                    </li>
                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-moon-stars-fill text-primary fs-6"></i>
                                        <strong class="text-dark">الليالي:</strong>
                                        <span class="badge bg-light text-dark border">@pNights ليالٍ</span>
                                    </li>

                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 my-1"><hr class="my-1 border-secondary opacity-25" /></li>

                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center justify-content-between">
                                        <span><i class="bi bi-cash-stack text-success ms-1"></i><strong>الإجمالي:</strong></span>
                                        <span class="fw-bold text-dark">@primaryBooking.TotalAmount.ToString("N2") ج.م</span>
                                    </li>
                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center justify-content-between">
                                        <span><i class="bi bi-exclamation-circle-fill text-danger ms-1"></i><strong>المتبقي:</strong></span>
                                        <span class="fw-bold text-danger bg-danger bg-opacity-10 px-2 py-1 rounded">@primaryBooking.RemainingAmount.ToString("N2") ج.م</span>
                                    </li>

                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-start gap-2 mt-1">
                                        <i class="bi bi-sticky-fill text-warning fs-6 mt-1"></i>
                                        <small class="text-muted bg-light p-2 rounded w-100 border">
                                            <strong>الملاحظات:</strong> @(string.IsNullOrWhiteSpace(primaryBooking.Notes) ? "لا يوجد" : primaryBooking.Notes)
                                        </small>
                                    </li>

                                    <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-1 text-muted small mt-2">
                                        <i class="bi bi-person-badge ms-1"></i>
                                        <span>الموظف: </span>
                                        <span class="fw-bold text-dark">@primaryBooking.CreatedByUserName</span>
                                    </li>
                                </ul>

                                <!-- أزرار الإجراءات للوجه الأول -->
                                @if (canAddHousingBooking)
                                {
                                    <button style="width: 100%;" class="btn btn-primary btn-sm rounded-pill px-2 shadow-sm fw-bold mb-2"
                                            onclick="openCreateModal(@room.Id, '@room.RoomNumber')"
                                            title="إضافة حجز إسكان بعد الـ MU">
                                        <i class="bi bi-plus-circle-fill"></i> حجز اسكان بعد الميكب
                                    </button>
                                }
                                <div class="d-flex align-items-center gap-1 pt-2 border-top flex-wrap">

                                    <a asp-controller="Booking" asp-action="Invoice" asp-route-id="@primaryBooking.Id" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-2 shadow-sm" title="طباعة الفاتورة">
                                        <i class="bi bi-printer-fill"></i>
                                    </a>

                                    <button class="btn btn-warning btn-sm flex-fill fw-bold rounded-pill shadow-sm"
                                            data-id="@primaryBooking.Id"
                                            data-room-id="@primaryBooking.RoomId"
                                            data-guest-name="@primaryBooking.GuestName"
                                            data-guest-phone="@primaryBooking.GuestPhone"
                                            data-room-type="@primaryBooking.RoomType"
                                            data-occupancy-type="@primaryBooking.OccupancyType"
                                            data-meal-type="@primaryBooking.MealType"
                                            data-has-food="@primaryBooking.HasFood.ToString().ToLower()"
                                            data-daily-food="@primaryBooking.DailyFoodAmount.ToString(CultureInfo.InvariantCulture)"
                                            data-price="@primaryBooking.PricePerNight.ToString(CultureInfo.InvariantCulture)"
                                            data-paid="@primaryBooking.PaidAmount.ToString(CultureInfo.InvariantCulture)"
                                            data-receipt="@primaryBooking.ReceiptNumber"
                                            data-check-in="@primaryBooking.CheckInDate.ToString("yyyy-MM-dd")"
                                            data-check-out="@primaryBooking.CheckOutDate.ToString("yyyy-MM-dd")"
                                            data-notes="@primaryBooking.Notes"
                                            onclick="openEditModalFromButton(this)">
                                        <i class="bi bi-pencil-square"></i> تعديل
                                    </button>

                                    <button class="btn btn-info btn-sm text-white flex-fill fw-bold rounded-pill shadow-sm"
                                            data-booking-id="@primaryBooking.Id"
                                            data-room-number="@room.RoomNumber"
                                            data-guest-name="@primaryBooking.GuestName"
                                            onclick="openTransferModalFromButton(this)">
                                        <i class="bi bi-arrow-left-right"></i> نقل
                                    </button>

                                    <form asp-controller="Booking" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('هل أنت تأكد من حذف الحجز؟');">
                                        <input type="hidden" name="id" value="@primaryBooking.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- الوجه الثاني: حجز الإسكان الجديد -->
                            @if (hasDoubleBooking && housingBooking != null)
                            {
                                <div id="booking-side-secondary-@room.Id" class="booking-side d-none">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0 fs-7 fw-bold" onclick="toggleRoomView(@room.Id, 'primary')">
                                            <i class="bi bi-chevron-right"></i> الـ MU
                                        </button>
                                        <span class="badge bg-success">حجز 2 (إسكان)</span>
                                    </div>

                                    @{
                                        var hNights = (int)(housingBooking.CheckOutDate - housingBooking.CheckInDate).TotalDays;
                                        if (hNights <= 0) hNights = 1;
                                    }

                                    <ul class="list-group list-group-flush p-0 mb-3 small fs-6">
                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-person-fill text-primary fs-5"></i>
                                            <strong class="text-dark">الاسم:</strong>
                                            <span class="text-secondary fw-semibold text-truncate">@housingBooking.GuestName</span>
                                        </li>
                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-telephone-fill text-success fs-6"></i>
                                            <strong class="text-dark">موبايل:</strong>
                                            <span class="text-secondary dir-ltr">@housingBooking.GuestPhone</span>
                                        </li>
                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-house-door-fill text-primary fs-6"></i>
                                            <strong class="text-dark">نوع الغرفة:</strong>
                                            <span class="badge bg-secondary">@(string.IsNullOrEmpty(housingBooking.RoomType) ? "إسكان" : housingBooking.RoomType)</span>
                                        </li>

                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-people-fill text-info fs-6"></i>
                                            <strong class="text-dark">عدد الأفراد:</strong>
                                            <span class="badge bg-info text-dark">@(string.IsNullOrEmpty(housingBooking.OccupancyType) ? "سنجل" : housingBooking.OccupancyType)</span>
                                        </li>

                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-egg-fried text-warning fs-6"></i>
                                            <strong class="text-dark">الأغذية:</strong>
                                            <span class="text-secondary">@(string.IsNullOrEmpty(housingBooking.MealType) ? "بدون وجبات" : housingBooking.MealType)</span>
                                        </li>

                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar-check-fill text-info fs-6"></i>
                                            <strong class="text-dark">الوصول:</strong>
                                            <span class="text-secondary">@housingBooking.CheckInDate.ToString("yyyy/MM/dd")</span>
                                        </li>
                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar-x-fill text-warning fs-6"></i>
                                            <strong class="text-dark">المغادرة:</strong>
                                            <span class="text-secondary">@housingBooking.CheckOutDate.ToString("yyyy/MM/dd")</span>
                                        </li>
                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-moon-stars-fill text-primary fs-6"></i>
                                            <strong class="text-dark">الليالي:</strong>
                                            <span class="badge bg-light text-dark border">@hNights ليالٍ</span>
                                        </li>

                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 my-1"><hr class="my-1 border-secondary opacity-25" /></li>

                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center justify-content-between">
                                            <span><i class="bi bi-cash-stack text-success ms-1"></i><strong>الإجمالي:</strong></span>
                                            <span class="fw-bold text-dark">@housingBooking.TotalAmount.ToString("N2") ج.م</span>
                                        </li>
                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center justify-content-between">
                                            <span><i class="bi bi-exclamation-circle-fill text-danger ms-1"></i><strong>المتبقي:</strong></span>
                                            <span class="fw-bold text-danger bg-danger bg-opacity-10 px-2 py-1 rounded">@housingBooking.RemainingAmount.ToString("N2") ج.م</span>
                                        </li>

                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-start gap-2 mt-1">
                                            <i class="bi bi-sticky-fill text-warning fs-6 mt-1"></i>
                                            <small class="text-muted bg-light p-2 rounded w-100 border">
                                                <strong>الملاحظات:</strong> @(string.IsNullOrWhiteSpace(housingBooking.Notes) ? "لا يوجد" : housingBooking.Notes)
                                            </small>
                                        </li>

                                        <li class="list-group-item px-0 py-1 bg-transparent border-0 d-flex align-items-center gap-1 text-muted small mt-2">
                                            <i class="bi bi-person-badge ms-1"></i>
                                            <span>الموظف: </span>
                                            <span class="fw-bold text-dark">@housingBooking.CreatedByUserName</span>
                                        </li>
                                    </ul>

                                    <!-- أزرار الإجراءات للوجه الثاني -->
                                    <div class="d-flex align-items-center gap-1 pt-2 border-top flex-wrap">
                                        <a asp-controller="Booking" asp-action="Invoice" asp-route-id="@housingBooking.Id" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-2 shadow-sm" title="طباعة الفاتورة">
                                            <i class="bi bi-printer-fill"></i>
                                        </a>

                                        <button class="btn btn-warning btn-sm flex-fill fw-bold rounded-pill shadow-sm"
                                                data-id="@housingBooking.Id"
                                                data-room-id="@housingBooking.RoomId"
                                                data-guest-name="@housingBooking.GuestName"
                                                data-guest-phone="@housingBooking.GuestPhone"
                                                data-room-type="@housingBooking.RoomType"
                                                data-occupancy-type="@housingBooking.OccupancyType"
                                                data-meal-type="@housingBooking.MealType"
                                                data-has-food="@housingBooking.HasFood.ToString().ToLower()"
                                                data-daily-food="@housingBooking.DailyFoodAmount.ToString(CultureInfo.InvariantCulture)"
                                                data-price="@housingBooking.PricePerNight.ToString(CultureInfo.InvariantCulture)"
                                                data-paid="@housingBooking.PaidAmount.ToString(CultureInfo.InvariantCulture)"
                                                data-receipt="@housingBooking.ReceiptNumber"
                                                data-check-in="@housingBooking.CheckInDate.ToString("yyyy-MM-dd")"
                                                data-check-out="@housingBooking.CheckOutDate.ToString("yyyy-MM-dd")"
                                                data-notes="@housingBooking.Notes"
                                                onclick="openEditModalFromButton(this)">
                                            <i class="bi bi-pencil-square"></i> تعديل
                                        </button>

                                        <button class="btn btn-info btn-sm text-white flex-fill fw-bold rounded-pill shadow-sm"
                                                data-booking-id="@housingBooking.Id"
                                                data-room-number="@room.RoomNumber"
                                                data-guest-name="@housingBooking.GuestName"
                                                onclick="openTransferModalFromButton(this)">
                                            <i class="bi bi-arrow-left-right"></i> نقل
                                        </button>

                                        <form asp-controller="Booking" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('هل أنت تأكد من حذف الحجز؟');">
                                            <input type="hidden" name="id" value="@housingBooking.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- حالة الغرفة المتاحة -->
                            <div class="text-center py-5 my-auto">
                                <i class="bi bi-check-circle-fill text-success display-4 mb-3 d-block opacity-75"></i>
                                <span class="badge bg-success bg-opacity-10 text-success fs-6 px-3 py-2 rounded-pill mb-4 border border-success">الغرفة جاهزة للحجز</span>
                                <div>
                                    <button class="btn btn-primary w-100 fw-bold rounded-pill shadow-sm py-2" onclick="openCreateModal(@room.Id, '@room.RoomNumber')">
                                        <i class="bi bi-plus-circle-fill ms-1"></i> حجز جديد
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<!-- Modal 1: إضافة حجز جديد -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" dir="rtl">
            <form asp-controller="Booking" asp-action="Create" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">إضافة حجز لغرفة <span id="modalRoomNumber"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="RoomId" id="modalRoomId" />

                    <div class="mb-2">
                        <label class="form-label">اسم النزيل</label>
                        <input type="text" name="GuestName" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">رقم الموبايل</label>
                        <input type="text" name="GuestPhone" id="guestPhoneInput" class="form-control" maxlength="11" oninput="validatePhone(this)" placeholder="010XXXXXXXX" required />
                        <small id="phoneError" class="text-danger" style="display: none;"></small>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">نوع الغرفة</label>
                        <select name="RoomType" id="createRoomType" class="form-select" onchange="toggleOccupancy('createRoomType', 'createOccupancyContainer')" required>
                            <option value="">-- اختر نوع الغرفة --</option>
                            <option value="إسكان">إسكان</option>
                            <option value="MU">MU</option>
                        </select>
                    </div>

                    <div class="mb-2" id="createOccupancyContainer">
